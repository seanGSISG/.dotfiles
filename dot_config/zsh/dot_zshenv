# Skip system compinit (we run our own in plugins.zsh)
skip_global_compinit=1

# --- mise shims (tool version pinning) ---
# This file, NOT ~/.zshenv, is what zsh reads once ZDOTDIR is already exported
# (nested shells, agent/herdr panes, anything launched from an existing session).
# ~/.zshenv only runs on a fresh login while ZDOTDIR is still unset, so the block
# lives in both. Guarded and idempotent so a double-source cannot duplicate PATH.
if [[ -d "$HOME/.local/share/mise/shims" ]]; then
  case ":$PATH:" in
    *":$HOME/.local/share/mise/shims:"*) ;;
    *) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
  esac
fi
