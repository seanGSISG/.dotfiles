#!/bin/bash
# Install CLI tools that the shell config depends on
# run_once_before_ ensures this runs before other scripts on first chezmoi apply
# Idempotent: each tool is skipped if already installed

set -e

{{ if eq .chezmoi.os "linux" -}}

echo "Installing CLI tools..."

# --- Tools available via apt ---
NEED_APT=()

command -v zoxide &>/dev/null  || NEED_APT+=(zoxide)
command -v eza &>/dev/null     || NEED_APT+=(eza)
# bat ships as 'batcat' on Debian/Ubuntu
command -v bat &>/dev/null || command -v batcat &>/dev/null || NEED_APT+=(bat)

# Remove apt fzf if installed (too old, need 0.48+ for --zsh/--bash flags)
if dpkg -l fzf &>/dev/null 2>&1; then
  echo "Removing apt fzf (too old)..."
  sudo apt-get remove -y -qq fzf
fi

if [ ${#NEED_APT[@]} -gt 0 ]; then
  echo "Installing via apt: ${NEED_APT[*]}"
  sudo apt-get update -qq
  sudo apt-get install -y -qq "${NEED_APT[@]}"
fi

# --- Starship (install script, no apt package for ARM64) ---
if ! command -v starship &>/dev/null; then
  echo "Installing starship..."
  curl -sS https://starship.rs/install.sh -o /tmp/starship-install.sh
  sudo sh /tmp/starship-install.sh --yes
  rm -f /tmp/starship-install.sh
fi

# --- fnm (Fast Node Manager, installs to ~/.local/share/fnm/) ---
if ! command -v fnm &>/dev/null && [ ! -f "$HOME/.local/share/fnm/fnm" ]; then
  echo "Installing fnm..."
  curl -fsSL https://fnm.vercel.app/install | bash
fi

# --- fzf (GitHub binary, apt version is too old) ---
FZF_VERSION="0.70.0"
if ! fzf --version 2>/dev/null | grep -q "$FZF_VERSION"; then
  echo "Installing fzf $FZF_VERSION..."
  ARCH=$(dpkg --print-architecture)
  curl -sL "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_${ARCH}.tar.gz" | tar xz -C /tmp
  sudo mv /tmp/fzf /usr/local/bin/fzf
fi

# --- Atuin (installs to ~/.atuin/bin/) ---
if ! command -v atuin &>/dev/null && [ ! -f "$HOME/.atuin/bin/atuin" ]; then
  echo "Installing atuin..."
  curl -sSf https://setup.atuin.sh | bash
fi

# --- Go (installs to /usr/local/go) ---
if ! command -v go &>/dev/null; then
  echo "Installing Go..."
  GO_VERSION=$(curl -sL 'https://go.dev/VERSION?m=text' | head -1)
  if [ -n "$GO_VERSION" ]; then
    curl -fsSL "https://go.dev/dl/${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz
    sudo rm -rf /usr/local/go
    sudo tar -C /usr/local -xzf /tmp/go.tar.gz
    rm -f /tmp/go.tar.gz
    export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"
  fi
fi

# --- golangci-lint (installs to ~/go/bin) ---
if ! command -v golangci-lint &>/dev/null && command -v go &>/dev/null; then
  echo "Installing golangci-lint..."
  mkdir -p "$HOME/go/bin"
  curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh | sh -s -- -b "$HOME/go/bin"
fi

echo "CLI tools installed."

{{ end -}}
